<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.netpilot</groupId>
    <artifactId>netpilot</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>NetPilot</name>
    <description>Network management toolkit. Currently supports MikroTik Hotspot user generation, QR vouchers, and RouterOS scripts.</description>
    <url>https://github.com/0xibrR/netpilot</url>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <main.module>org.netpilot</main.module>
        <main.class>org.netpilot.Launcher</main.class>

        <javafx.version>27.0.1</javafx.version>
        <openpdf.version>3.0.5</openpdf.version>
        <zxing.version>3.5.4</zxing.version>
        <jna.version>5.19.1</jna.version>
        <jackson.version>3.2.4</jackson.version>
        <junit.version>6.1.3</junit.version>

        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <javafx-maven-plugin.version>0.0.8</javafx-maven-plugin.version>

        <!-- Quality gates -->
        <spotless.version>3.11.0</spotless.version>
        <jacoco.version>0.8.16</jacoco.version>
        <coverage.minimum>0.80</coverage.minimum>
        <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
    </properties>

    <dependencies>
        <!-- UI -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- PDF vouchers -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>

        <!-- QR codes -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>${zxing.version}</version>
        </dependency>

        <!-- Windows DPAPI: encrypts a remembered router password with the user's Windows account -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>${jna.version}</version>
        </dependency>

        <!-- JSON responses from the RouterOS REST API -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- Tests use the JDK's built-in HTTP server to fake a router -->
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>jdk.httpserver</arg>
                                <arg>--add-reads</arg>
                                <arg>org.netpilot=jdk.httpserver</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- @{argLine} keeps the JaCoCo agent -->
                    <argLine>@{argLine} --add-modules jdk.httpserver --add-reads org.netpilot=jdk.httpserver --enable-native-access=com.sun.jna,ALL-UNNAMED</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!--
                Code formatting. `mvnw verify` fails on unformatted code;
                fix it with: mvnw spotless:apply
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <!-- Eclipse JDT is pure Java, so it works on every JDK version -->
                        <eclipse>
                            <file>${project.basedir}/config/eclipse-formatter.prefs</file>
                        </eclipse>
                        <removeUnusedImports/>
                        <importOrder/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>

            <!--
                Test coverage. `mvnw verify` fails if model/service/repository code drops
                below the minimum. Report: target/site/jacoco/index.html
                UI classes are excluded: they are tested manually.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>org/netpilot/controller/**</exclude>
                        <exclude>org/netpilot/NetPilotApp*</exclude>
                        <exclude>org/netpilot/Launcher*</exclude>
                        <exclude>org/netpilot/AppContext*</exclude>
                        <exclude>org/netpilot/AppLogging*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Static analysis for likely bugs. `mvnw verify` fails on findings.
                Browse findings with: mvnw spotbugs:gui
            -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <excludeFilterFile>${project.basedir}/config/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- Run with: mvnw javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx-maven-plugin.version}</version>
                <configuration>
                    <mainClass>${main.module}/${main.class}</mainClass>
                    <options>
                        <option>--enable-native-access=javafx.graphics,com.sun.jna</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Windows installer: mvnw clean -Pinstaller package
          Builds target/installer/NetPilot-<version>-windows.zip (portable, runs without installing)
          and, with -Dinstaller.exe=true and the WiX Toolset installed, NetPilot-<version>.exe.
          Both bring their own Java, so the computer needs nothing else. See docs/INSTALLER.md.
        -->
        <profile>
            <id>installer</id>
            <properties>
                <!-- numbers only: Windows rejects -SNAPSHOT; keep equal to NetPilotApp.VERSION -->
                <installer.version>1.0.0</installer.version>
                <installer.exe>false</installer.exe>
                <installer.dir>${project.build.directory}/installer</installer.dir>
                <installer.fx.classifier>win</installer.fx.classifier>
                <!-- what the app uses from the JDK (jdeps), plus Arabic dates and numbers -->
                <installer.jdk.modules>java.base,java.desktop,java.logging,java.net.http,java.xml,java.naming,jdk.unsupported,jdk.localedata,jdk.charsets,jdk.crypto.cryptoki,jdk.zipfs,javafx.controls,javafx.fxml</installer.jdk.modules>
                <!-- lets Windows replace an older install with a newer one; never change it -->
                <installer.upgrade.uuid>71f9b44a-51a1-4124-a32e-15e35cb0b8cf</installer.upgrade.uuid>
                <installer.vendor>Ibrahim Ramadan</installer.vendor>
                <installer.description>MikroTik hotspot cards and management</installer.description>
            </properties>
            <build>
                <plugins>
                    <!-- declared first: in prepare-package it clears the old output before the copy below -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>installer-clean</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete dir="${installer.dir}"/>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>installer-package</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target xmlns:if="ant:if">
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                              todir="${installer.dir}/mods"/>

                                        <!-- a small Java runtime with JavaFX inside -->
                                        <exec executable="${java.home}/bin/jlink" failonerror="true">
                                            <arg value="--module-path"/>
                                            <arg value="${installer.dir}/fx"/>
                                            <arg value="--add-modules"/>
                                            <arg value="${installer.jdk.modules}"/>
                                            <arg value="--include-locales=en,ar"/>
                                            <arg value="--strip-debug"/>
                                            <arg value="--no-header-files"/>
                                            <arg value="--no-man-pages"/>
                                            <arg value="--output"/>
                                            <arg value="${installer.dir}/runtime"/>
                                        </exec>

                                        <!-- the NetPilot folder: NetPilot.exe, the app and its Java -->
                                        <exec executable="${java.home}/bin/jpackage" failonerror="true">
                                            <arg value="--type"/>
                                            <arg value="app-image"/>
                                            <arg value="--name"/>
                                            <arg value="NetPilot"/>
                                            <arg value="--app-version"/>
                                            <arg value="${installer.version}"/>
                                            <arg value="--vendor"/>
                                            <arg value="${installer.vendor}"/>
                                            <arg value="--description"/>
                                            <arg value="${installer.description}"/>
                                            <arg value="--icon"/>
                                            <arg value="${project.basedir}/packaging/windows/NetPilot.ico"/>
                                            <arg value="--runtime-image"/>
                                            <arg value="${installer.dir}/runtime"/>
                                            <arg value="--module-path"/>
                                            <arg value="${installer.dir}/mods"/>
                                            <arg value="--module"/>
                                            <arg value="${main.module}/${main.class}"/>
                                            <arg value="--java-options"/>
                                            <arg value="--enable-native-access=javafx.graphics,com.sun.jna"/>
                                            <arg value="--dest"/>
                                            <arg value="${installer.dir}/image"/>
                                        </exec>
                                        <zip destfile="${installer.dir}/NetPilot-${installer.version}-windows.zip"
                                             basedir="${installer.dir}/image"/>

                                        <!-- Setup.exe; needs the WiX Toolset (the GitHub build has it) -->
                                        <exec if:true="${installer.exe}" executable="${java.home}/bin/jpackage"
                                              failonerror="true">
                                            <arg value="--type"/>
                                            <arg value="exe"/>
                                            <arg value="--app-image"/>
                                            <arg value="${installer.dir}/image/NetPilot"/>
                                            <arg value="--name"/>
                                            <arg value="NetPilot"/>
                                            <arg value="--app-version"/>
                                            <arg value="${installer.version}"/>
                                            <arg value="--vendor"/>
                                            <arg value="${installer.vendor}"/>
                                            <arg value="--description"/>
                                            <arg value="${installer.description}"/>
                                            <arg value="--copyright"/>
                                            <arg value="${installer.vendor}"/>
                                            <arg value="--about-url"/>
                                            <arg value="${project.url}"/>
                                            <arg value="--win-upgrade-uuid"/>
                                            <arg value="${installer.upgrade.uuid}"/>
                                            <arg value="--win-per-user-install"/>
                                            <arg value="--win-dir-chooser"/>
                                            <arg value="--win-menu"/>
                                            <arg value="--win-menu-group"/>
                                            <arg value="NetPilot"/>
                                            <arg value="--win-shortcut"/>
                                            <arg value="--win-shortcut-prompt"/>
                                            <arg value="--dest"/>
                                            <arg value="${installer.dir}"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <!-- the app's libraries; JavaFX goes into the Java runtime instead -->
                            <execution>
                                <id>installer-libraries</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <excludeGroupIds>org.openjfx</excludeGroupIds>
                                    <outputDirectory>${installer.dir}/mods</outputDirectory>
                                </configuration>
                            </execution>
                            <execution>
                                <id>installer-javafx</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <includeGroupIds>org.openjfx</includeGroupIds>
                                    <includeClassifiers>${installer.fx.classifier}</includeClassifiers>
                                    <outputDirectory>${installer.dir}/fx</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
