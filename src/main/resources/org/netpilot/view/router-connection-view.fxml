<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.netpilot.controller.RouterConnectionController"
            styleClass="app-root" prefWidth="520">

    <center>
        <VBox spacing="12" styleClass="form">
            <VBox styleClass="card" spacing="10">
                <Label text="%connect.router" styleClass="card-title"/>
                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="110"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="%connect.address" GridPane.rowIndex="0"/>
                    <TextField fx:id="hostField" promptText="%connect.address.prompt" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="%connect.port" GridPane.rowIndex="1"/>
                    <HBox spacing="12" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <TextField fx:id="portField" prefColumnCount="6"/>
                        <CheckBox fx:id="httpsCheck" text="%connect.https"/>
                    </HBox>
                    <Label text="%connect.username" GridPane.rowIndex="2"/>
                    <TextField fx:id="usernameField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="%connect.password" GridPane.rowIndex="3"/>
                    <PasswordField fx:id="passwordField" promptText="%connect.password.prompt" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>
                <Label fx:id="httpWarning" styleClass="warning" wrapText="true" text="%connect.httpWarning"/>
            </VBox>

            <VBox styleClass="card" spacing="8">
                <Label text="%connect.certificate" styleClass="card-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="certificateLabel" styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="forgetCertificateButton" text="%connect.forget" onAction="#onForgetCertificate"/>
                </HBox>
            </VBox>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <ProgressIndicator fx:id="progressIndicator" visible="false" managed="false" prefWidth="18" prefHeight="18"/>
                <Label fx:id="resultLabel" wrapText="true" styleClass="status" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="action-bar" alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="testButton" text="%connect.test" onAction="#onTest"/>
            <Button text="%button.cancel" onAction="#onCancel" cancelButton="true"/>
            <Button fx:id="connectButton" text="%connect.connect" onAction="#onConnect" defaultButton="true" styleClass="primary"/>
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
        </HBox>
    </bottom>
</BorderPane>
