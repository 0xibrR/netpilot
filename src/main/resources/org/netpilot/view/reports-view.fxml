<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.netpilot.controller.ReportsController"
            styleClass="app-root" prefWidth="1000" prefHeight="700">

    <top>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Period" styleClass="section-title"/>
            <ComboBox fx:id="periodBox" prefWidth="160"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="progressIndicator" visible="false" managed="false" prefWidth="18" prefHeight="18"/>
            <Button fx:id="exportButton" text="Export CSV…" onAction="#onExport"/>
            <Button fx:id="refreshButton" text="⟳ Refresh" onAction="#onRefresh"/>
            <padding>
                <Insets top="12" right="12" bottom="0" left="12"/>
            </padding>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <HBox spacing="10">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Revenue" styleClass="stat-title"/>
                    <Label fx:id="revenueLabel" styleClass="stat-value, stat-money"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Still to come (unused cards)" styleClass="stat-title"/>
                    <Label fx:id="potentialLabel" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Cards sold" styleClass="stat-title"/>
                    <Label fx:id="soldLabel" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Never used" styleClass="stat-title"/>
                    <Label fx:id="unusedLabel" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Cards created" styleClass="stat-title"/>
                    <Label fx:id="createdLabel" styleClass="stat-value"/>
                </VBox>
            </HBox>

            <BarChart fx:id="dailyChart" title="Revenue per day (by first use)" legendVisible="false"
                      animated="false" prefHeight="220" minHeight="180">
                <xAxis>
                    <CategoryAxis fx:id="dayAxis"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="amountAxis"/>
                </yAxis>
            </BarChart>

            <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <Tab text="By batch">
                    <TableView fx:id="batchTable">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="batchColumn" text="Batch" prefWidth="280"/>
                            <TableColumn fx:id="batchCreatedColumn" text="Created" prefWidth="130"/>
                            <TableColumn fx:id="batchProfileColumn" text="Profile" prefWidth="80"/>
                            <TableColumn fx:id="batchCardsColumn" text="Cards" prefWidth="70"/>
                            <TableColumn fx:id="batchUsedColumn" text="Used" prefWidth="70"/>
                            <TableColumn fx:id="batchUnusedColumn" text="Unused" prefWidth="70"/>
                            <TableColumn fx:id="batchRevenueColumn" text="Revenue" prefWidth="120"/>
                        </columns>
                        <placeholder>
                            <Label text="No batches in this period." styleClass="muted"/>
                        </placeholder>
                    </TableView>
                </Tab>
                <Tab text="By profile">
                    <TableView fx:id="profileTable">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="profileColumn" text="Profile" prefWidth="120"/>
                            <TableColumn fx:id="profilePriceColumn" text="Price" prefWidth="110"/>
                            <TableColumn fx:id="profileSoldColumn" text="Sold" prefWidth="70"/>
                            <TableColumn fx:id="profileUnusedColumn" text="Unused" prefWidth="70"/>
                            <TableColumn fx:id="profileRevenueColumn" text="Revenue" prefWidth="120"/>
                            <TableColumn fx:id="profileDataColumn" text="Data used" prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="No profiles." styleClass="muted"/>
                        </placeholder>
                    </TableView>
                </Tab>
            </TabPane>

            <Label fx:id="warningsLabel" styleClass="warning" wrapText="true" visible="false" managed="false"/>
            <padding>
                <Insets top="10" right="12" bottom="12" left="12"/>
            </padding>
        </VBox>
    </center>
</BorderPane>
