<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.netpilot.controller.ReportsController"
            styleClass="page">

    <top>
        <VBox>
        <HBox alignment="CENTER_LEFT">
            <Label text="%nav.cards.sales" styleClass="page-title"/>
            <padding>
                <Insets top="16" right="20" bottom="2" left="20"/>
            </padding>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="%reports.period" styleClass="section-title"/>
            <ComboBox fx:id="periodBox" prefWidth="160"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="progressIndicator" visible="false" managed="false" prefWidth="18" prefHeight="18"/>
            <Button fx:id="monthlyButton" text="%monthly.button" onAction="#onMonthly" styleClass="primary"/>
            <Button fx:id="exportButton" text="%reports.export" onAction="#onExport"/>
            <Button fx:id="refreshButton" text="%button.refresh" onAction="#onRefresh"/>
            <padding>
                <Insets top="8" right="12" bottom="0" left="12"/>
            </padding>
        </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <HBox spacing="10">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="%report.revenue" styleClass="stat-title"/>
                    <Label fx:id="revenueLabel" styleClass="stat-value, stat-money"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="%report.potential" styleClass="stat-title"/>
                    <Label fx:id="potentialLabel" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="%report.sold" styleClass="stat-title"/>
                    <Label fx:id="soldLabel" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="%report.unused" styleClass="stat-title"/>
                    <Label fx:id="unusedLabel" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="%report.created" styleClass="stat-title"/>
                    <Label fx:id="createdLabel" styleClass="stat-value"/>
                </VBox>
            </HBox>

            <Label fx:id="warningsLabel" styleClass="warning, report-warning" wrapText="true" visible="false"
                   managed="false" minHeight="-Infinity" maxWidth="Infinity"/>

            <BarChart fx:id="dailyChart" title="%reports.chart" legendVisible="false"
                      animated="false" prefHeight="220" minHeight="180">
                <xAxis>
                    <CategoryAxis fx:id="dayAxis"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="amountAxis"/>
                </yAxis>
            </BarChart>

            <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <Tab text="%reports.byBatch">
                    <TableView fx:id="batchTable">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="batchColumn" text="%report.column.batch" prefWidth="280"/>
                            <TableColumn fx:id="batchCreatedColumn" text="%report.column.created" prefWidth="130"/>
                            <TableColumn fx:id="batchProfileColumn" text="%report.column.profile" prefWidth="80"/>
                            <TableColumn fx:id="batchCardsColumn" text="%report.column.cards" prefWidth="70"/>
                            <TableColumn fx:id="batchUsedColumn" text="%report.column.used" prefWidth="70"/>
                            <TableColumn fx:id="batchUnusedColumn" text="%report.column.unused" prefWidth="70"/>
                            <TableColumn fx:id="batchRevenueColumn" text="%report.column.revenue" prefWidth="120"/>
                        </columns>
                        <placeholder>
                            <Label text="%reports.noBatches" styleClass="muted"/>
                        </placeholder>
                    </TableView>
                </Tab>
                <Tab text="%reports.byProfile">
                    <TableView fx:id="profileTable">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="profileColumn" text="%report.column.profile" prefWidth="120"/>
                            <TableColumn fx:id="profilePriceColumn" text="%report.column.price" prefWidth="110"/>
                            <TableColumn fx:id="profileSoldColumn" text="%report.column.sold" prefWidth="70"/>
                            <TableColumn fx:id="profileUnusedColumn" text="%report.column.unused" prefWidth="70"/>
                            <TableColumn fx:id="profileRevenueColumn" text="%report.column.revenue" prefWidth="120"/>
                            <TableColumn fx:id="profileDataColumn" text="%reports.dataUsed" prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="%reports.noProfiles" styleClass="muted"/>
                        </placeholder>
                    </TableView>
                </Tab>
            </TabPane>

            <padding>
                <Insets top="10" right="12" bottom="12" left="12"/>
            </padding>
        </VBox>
    </center>
</BorderPane>
