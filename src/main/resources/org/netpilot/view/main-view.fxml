<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Texts: %key refers to org/netpilot/i18n/messages_*.properties -->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.netpilot.controller.MainController"
            styleClass="app-root">

    <!-- ===== Top: menu + header ===== -->
    <top>
        <VBox>
            <MenuBar>
                <Menu text="%menu.file">
                    <MenuItem text="%menu.file.openFolder" onAction="#onOpenOutputFolder"/>
                    <MenuItem text="%menu.file.changeFolder" onAction="#onBrowseOutputFolder"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="%menu.file.exit" onAction="#onExit"/>
                </Menu>
                <Menu text="%menu.router">
                    <MenuItem text="%menu.router.connect" onAction="#onConnectRouter" accelerator="Shortcut+R"/>
                    <MenuItem fx:id="manageUsersItem" text="%menu.router.manageUsers" onAction="#onManageUsers" accelerator="Shortcut+U"/>
                    <MenuItem fx:id="reportsItem" text="%menu.router.reports" onAction="#onReports" accelerator="Shortcut+T"/>
                    <MenuItem fx:id="refreshRouterItem" text="%menu.router.reload" onAction="#onRefreshRouter"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="disconnectRouterItem" text="%menu.router.disconnect" onAction="#onDisconnectRouter"/>
                </Menu>
                <Menu text="%menu.tools">
                    <MenuItem text="%menu.tools.voucherDesign" onAction="#onVoucherDesign" accelerator="Shortcut+D"/>
                    <MenuItem text="%menu.tools.history" onAction="#onShowHistory"/>
                    <MenuItem text="%menu.tools.preferences" onAction="#onPreferences" accelerator="Shortcut+COMMA"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="%menu.tools.reset" onAction="#onResetSettings"/>
                </Menu>
                <Menu text="%menu.help">
                    <MenuItem text="%menu.help.github" onAction="#onOpenRepository"/>
                    <MenuItem text="%menu.help.about" onAction="#onAbout"/>
                </Menu>
            </MenuBar>
            <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
                <Label text="NetPilot" styleClass="header-title"/>
                <Label text="%main.subtitle" styleClass="header-subtitle"/>
            </HBox>
        </VBox>
    </top>

    <!-- ===== Left: settings form ===== -->
    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll" prefWidth="380">
            <VBox spacing="14" styleClass="form">

                <VBox styleClass="card" spacing="10">
                    <Label text="%main.users" styleClass="card-title"/>
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="%main.count" GridPane.rowIndex="0"/>
                        <Spinner fx:id="countSpinner" editable="true" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="%main.usernameMode" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="usernameModeBox" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="%main.usernameLength" GridPane.rowIndex="2"/>
                        <Spinner fx:id="usernameLengthSpinner" editable="true" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="%main.startNumber" GridPane.rowIndex="3"/>
                        <Spinner fx:id="usernameStartSpinner" editable="true" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>

                <VBox styleClass="card" spacing="10">
                    <Label text="%main.passwords" styleClass="card-title"/>
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="%main.passwordMode" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="passwordModeBox" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="%main.passwordLength" GridPane.rowIndex="1"/>
                        <Spinner fx:id="passwordLengthSpinner" editable="true" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="%main.startNumber" GridPane.rowIndex="2"/>
                        <Spinner fx:id="passwordStartSpinner" editable="true" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="%main.prefix" GridPane.rowIndex="3"/>
                        <TextField fx:id="prefixField" promptText="%main.prefix.prompt" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </GridPane>
                    <Label fx:id="weakPasswordWarning" styleClass="warning" wrapText="true" text="%main.weakPassword"/>
                </VBox>

                <VBox styleClass="card" spacing="10">
                    <Label text="%main.hotspot" styleClass="card-title"/>
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="%main.profile" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="profileBox" editable="true" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="%main.server" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="serverBox" editable="true" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="%main.uptimeLimit" GridPane.rowIndex="2"/>
                        <ComboBox fx:id="uptimeBox" editable="true" maxWidth="Infinity" promptText="%main.uptimeLimit.prompt"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>

                <VBox styleClass="card" spacing="10">
                    <Label text="%main.vouchers" styleClass="card-title"/>
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="%main.loginUrl" GridPane.rowIndex="0"/>
                        <TextField fx:id="loginUrlField" promptText="%main.loginUrl.prompt" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="%main.perRow" GridPane.rowIndex="1"/>
                        <Spinner fx:id="perRowSpinner" editable="true" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="%main.outputFolder" GridPane.rowIndex="2"/>
                        <HBox spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <TextField fx:id="outputDirField" editable="false" HBox.hgrow="ALWAYS"/>
                            <Button text="…" onAction="#onBrowseOutputFolder"/>
                        </HBox>
                    </GridPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </left>

    <!-- ===== Center: preview table ===== -->
    <center>
        <VBox spacing="8" styleClass="preview">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="%main.preview" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="usersCountLabel" styleClass="muted"/>
            </HBox>
            <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="indexColumn" text="#" prefWidth="60" maxWidth="80" sortable="false"/>
                    <TableColumn fx:id="usernameColumn" text="%column.username" prefWidth="170"/>
                    <TableColumn fx:id="passwordColumn" text="%column.password" prefWidth="170"/>
                    <TableColumn fx:id="profileColumn" text="%column.profile" prefWidth="100"/>
                    <TableColumn fx:id="serverColumn" text="%column.server" prefWidth="100"/>
                    <TableColumn fx:id="uptimeColumn" text="%column.uptimeLimit" prefWidth="110"/>
                </columns>
                <placeholder>
                    <Label text="%main.preview.empty" styleClass="muted"/>
                </placeholder>
            </TableView>
        </VBox>
    </center>

    <!-- ===== Bottom: actions + status ===== -->
    <bottom>
        <HBox styleClass="action-bar" alignment="CENTER_LEFT" spacing="10">
            <ProgressIndicator fx:id="progressIndicator" visible="false" managed="false" prefWidth="20" prefHeight="20"/>
            <Label fx:id="routerStatusLabel" styleClass="router-status" onMouseClicked="#onRouterStatusClicked">
                <tooltip>
                    <Tooltip text="%main.routerStatus.tooltip"/>
                </tooltip>
            </Label>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="statusLabel" text="%status.ready" styleClass="status"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%main.history" onAction="#onShowHistory"/>
            <Button text="%main.openFolder" onAction="#onOpenOutputFolder"/>
            <Button fx:id="generateButton" text="%main.generate" onAction="#onGenerate" defaultButton="true"/>
            <Button fx:id="exportButton" text="%main.export" onAction="#onExport"/>
            <Button fx:id="sendButton" text="%main.send" onAction="#onSendToRouter" styleClass="primary">
                <tooltip>
                    <Tooltip text="%main.send.tooltip"/>
                </tooltip>
            </Button>
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
        </HBox>
    </bottom>
</BorderPane>
