<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Main window, laid out like WinBox: top bar, side menu, page area, status bar.
     Texts: %key refers to org/netpilot/i18n/messages_*.properties -->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="root"
            fx:controller="org.netpilot.controller.MainController"
            styleClass="app-root">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <Label text="NetPilot" styleClass="brand"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="routerChip" styleClass="router-chip" onMouseClicked="#onRouterChipClicked">
                <tooltip>
                    <Tooltip text="%main.routerStatus.tooltip"/>
                </tooltip>
            </Label>
            <MenuButton fx:id="routerMenu" styleClass="chrome-button" text="%menu.router.short">
                <items>
                    <MenuItem text="%menu.router.connect" onAction="#onConnectRouter" accelerator="Shortcut+R"/>
                    <MenuItem fx:id="reloadItem" text="%menu.router.reload" onAction="#onReloadRouter"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="disconnectItem" text="%menu.router.disconnect" onAction="#onDisconnectRouter"/>
                </items>
            </MenuButton>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="themeButton" styleClass="chrome-button" onAction="#onToggleTheme">
                <tooltip>
                    <Tooltip text="%main.toggleTheme"/>
                </tooltip>
            </Button>
            <padding>
                <Insets top="6" right="12" bottom="6" left="12"/>
            </padding>
        </HBox>
    </top>

    <left>
        <VBox fx:id="sideMenu" styleClass="side-menu" prefWidth="190" spacing="2">
            <padding>
                <Insets top="8" bottom="8"/>
            </padding>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="pageHost" styleClass="page-host">
            <VBox fx:id="notConnectedPane" styleClass="not-connected" alignment="CENTER" spacing="12" visible="false">
                <Label text="%main.notConnected.title" styleClass="section-title"/>
                <Label text="%main.notConnected.body" styleClass="muted" wrapText="true" maxWidth="420"/>
                <Button text="%menu.router.connect" onAction="#onConnectRouter" styleClass="primary"/>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="18">
            <Label fx:id="routerInfoLabel" styleClass="status-item"/>
            <Label fx:id="cpuLabel" styleClass="status-item"/>
            <Label fx:id="memoryLabel" styleClass="status-item"/>
            <Label fx:id="uptimeLabel" styleClass="status-item"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="liveLabel" text="%status.live" styleClass="status-item, live" visible="false" managed="false">
                <tooltip>
                    <Tooltip text="%status.live.tooltip"/>
                </tooltip>
            </Label>
            <Label fx:id="clockLabel" styleClass="status-item, clock"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="versionLabel" styleClass="status-item"/>
            <padding>
                <Insets top="4" right="12" bottom="4" left="12"/>
            </padding>
        </HBox>
    </bottom>
</BorderPane>
