<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Dashboard page. Texts: %key refers to org/netpilot/i18n/messages_*.properties -->
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.netpilot.controller.DashboardController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page, form-scroll">
    <VBox spacing="14">
        <padding>
            <Insets top="16" right="20" bottom="16" left="20"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="%nav.DASHBOARD" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="progressIndicator" visible="false" managed="false" prefWidth="18" prefHeight="18"/>
            <Button fx:id="refreshButton" text="%button.refresh" onAction="#onRefresh"/>
        </HBox>

        <!-- a newer NetPilot is published: shown by the daily update check -->
        <HBox fx:id="updateBanner" styleClass="update-banner" spacing="8" alignment="CENTER_LEFT"
              visible="false" managed="false">
            <Label fx:id="updateLabel" styleClass="update-title" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="%update.whatsNewButton" onAction="#onUpdateDetails" minWidth="-Infinity"/>
            <Button text="%update.now" onAction="#onUpdateNow" styleClass="primary" minWidth="-Infinity"/>
            <Button text="%update.later" onAction="#onUpdateLater" styleClass="flat" minWidth="-Infinity"/>
            <Button text="%update.skip" onAction="#onUpdateSkip" styleClass="flat" minWidth="-Infinity"/>
        </HBox>

        <VBox fx:id="offlineCard" styleClass="card, welcome-card" spacing="12">
            <Label text="%dashboard.welcome" styleClass="card-title"/>
            <Label text="%dashboard.offline" styleClass="muted" wrapText="true"/>
            <FlowPane hgap="12" vgap="12">
                <VBox styleClass="step-card" spacing="6" prefWidth="220">
                    <Label text="1" styleClass="step-number"/>
                    <Label text="%dashboard.step1" styleClass="step-title" wrapText="true"/>
                    <Label text="%dashboard.step1.body" styleClass="muted" wrapText="true"/>
                    <Button text="%menu.router.connect" onAction="#onConnect" styleClass="primary"/>
                </VBox>
                <VBox styleClass="step-card" spacing="6" prefWidth="220">
                    <Label text="2" styleClass="step-number"/>
                    <Label text="%dashboard.step2" styleClass="step-title" wrapText="true"/>
                    <Label text="%dashboard.step2.body" styleClass="muted" wrapText="true"/>
                    <Button text="%nav.DESIGN" onAction="#onDesign"/>
                </VBox>
                <VBox styleClass="step-card" spacing="6" prefWidth="220">
                    <Label text="3" styleClass="step-number"/>
                    <Label text="%dashboard.step3" styleClass="step-title" wrapText="true"/>
                    <Label text="%dashboard.step3.body" styleClass="muted" wrapText="true"/>
                    <Button text="%nav.GENERATE" onAction="#onGenerate"/>
                </VBox>
            </FlowPane>
        </VBox>

        <VBox fx:id="routerCard" styleClass="card" spacing="4">
            <Label fx:id="routerName" styleClass="stat-value"/>
            <Label fx:id="routerDetails" styleClass="muted"/>
        </VBox>

        <!-- one button per priced package: the oldest unused card is printed and recorded as sold -->
        <VBox fx:id="quickSaleCard" styleClass="card" spacing="8" visible="false" managed="false">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="%quickSale.title" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="%quickSale.hint" styleClass="muted"/>
            </HBox>
            <FlowPane fx:id="quickSaleButtons" hgap="8" vgap="8" styleClass="quick-sale-buttons"/>
            <Label fx:id="quickSaleEmpty" text="%quickSale.noPrices" styleClass="muted" wrapText="true"
                   visible="false" managed="false"/>
            <!-- sales left unfinished after a crash or a failed save: the user settles each one -->
            <VBox fx:id="quickSalePending" spacing="6" styleClass="stock-card" visible="false" managed="false">
                <padding>
                    <Insets top="8" right="10" bottom="8" left="10"/>
                </padding>
            </VBox>
            <Label fx:id="quickSaleToday" styleClass="muted"/>
        </VBox>

        <FlowPane hgap="12" vgap="12">
            <VBox styleClass="stat-card" prefWidth="190">
                <Label text="%dashboard.users" styleClass="stat-title"/>
                <Label fx:id="usersValue" text="—" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card" prefWidth="190">
                <Label text="%dashboard.online" styleClass="stat-title"/>
                <Label fx:id="onlineValue" text="—" styleClass="stat-value, stat-online"/>
            </VBox>
            <VBox styleClass="stat-card" prefWidth="190">
                <Label text="%report.unused" styleClass="stat-title"/>
                <Label fx:id="unusedValue" text="—" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card" prefWidth="190">
                <Label text="%users.state.expired" styleClass="stat-title"/>
                <Label fx:id="expiredValue" text="—" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card" prefWidth="190">
                <Label text="%dashboard.revenueMonth" styleClass="stat-title"/>
                <Label fx:id="revenueValue" text="—" styleClass="stat-value, stat-money"/>
            </VBox>
            <VBox styleClass="stat-card" prefWidth="190">
                <Label text="%report.potential" styleClass="stat-title" wrapText="true"/>
                <Label fx:id="potentialValue" text="—" styleClass="stat-value"/>
            </VBox>
        </FlowPane>

        <!-- packages running out of unused cards (limit in Settings); hidden when none -->
        <VBox fx:id="stockCard" styleClass="card, stock-card" spacing="8" visible="false" managed="false">
            <Label text="%stock.title" styleClass="card-title"/>
            <VBox fx:id="stockRows" spacing="6"/>
        </VBox>

        <VBox styleClass="card" spacing="10">
            <Label text="%dashboard.quick" styleClass="card-title"/>
            <FlowPane hgap="8" vgap="8">
                <Button fx:id="generateQuick" text="%nav.GENERATE" onAction="#onGenerate" styleClass="primary"/>
                <Button fx:id="hotspotQuick" text="%nav.cards.users" onAction="#onHotspot"/>
                <Button fx:id="reportsQuick" text="%nav.REPORTS" onAction="#onReports"/>
                <Button fx:id="designQuick" text="%nav.DESIGN" onAction="#onDesign"/>
            </FlowPane>
        </VBox>
    </VBox>
</ScrollPane>
