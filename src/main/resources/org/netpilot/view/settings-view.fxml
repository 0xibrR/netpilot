<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Settings page. Texts: %key refers to org/netpilot/i18n/messages_*.properties -->
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.netpilot.controller.SettingsController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page, form-scroll">
    <VBox spacing="14" maxWidth="640">
        <padding>
            <Insets top="16" right="20" bottom="16" left="20"/>
        </padding>
        <Label text="%nav.SETTINGS" styleClass="page-title"/>

        <VBox styleClass="card" spacing="10">
            <Label text="%settings.appearance" styleClass="card-title"/>
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="%prefs.language" GridPane.rowIndex="0"/>
                <ComboBox fx:id="languageBox" maxWidth="260" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="%prefs.theme" GridPane.rowIndex="2"/>
                <ComboBox fx:id="themeBox" maxWidth="260" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="%settings.accent" GridPane.rowIndex="3"/>
                <HBox fx:id="accentBox" spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
            <Label text="%settings.appliedAtOnce" styleClass="muted" wrapText="true"/>
        </VBox>

        <VBox styleClass="card" spacing="10">
            <Label text="%cleanup.title" styleClass="card-title"/>
            <CheckBox fx:id="cleanupCheck" text="%cleanup.enable" wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%cleanup.time"/>
                <ComboBox fx:id="cleanupTimeBox"/>
            </HBox>
            <Label fx:id="cleanupLastLabel" styleClass="muted" wrapText="true"/>
            <Label text="%cleanup.help" styleClass="muted" wrapText="true"/>
        </VBox>

        <VBox styleClass="card" spacing="10">
            <Label text="%stock.settings.title" styleClass="card-title"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%stock.settings.below" wrapText="true"/>
                <Spinner fx:id="lowStockSpinner" editable="true" prefWidth="100"/>
            </HBox>
            <Label text="%stock.settings.help" styleClass="muted" wrapText="true"/>
        </VBox>

        <VBox styleClass="card" spacing="10">
            <Label text="%backup.title" styleClass="card-title"/>
            <HBox spacing="8">
                <Button fx:id="backupNowButton" text="%backup.create" onAction="#onBackupNow" styleClass="primary"/>
                <Button fx:id="restoreButton" text="%backup.restore" onAction="#onRestore"/>
            </HBox>
            <CheckBox fx:id="autoBackupCheck" text="%backup.auto" wrapText="true"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="%backup.folder"/>
                <Label fx:id="backupFolderLabel" styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS"/>
                <Button text="%backup.chooseFolder" onAction="#onChooseBackupFolder"/>
            </HBox>
            <Label fx:id="lastBackupLabel" styleClass="muted" wrapText="true"/>
            <Label text="%backup.help" styleClass="muted" wrapText="true"/>
        </VBox>

        <VBox styleClass="card" spacing="10">
            <Label text="%update.settings.title" styleClass="card-title"/>
            <CheckBox fx:id="autoUpdateCheck" text="%update.settings.auto" wrapText="true"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="checkUpdateButton" text="%update.settings.checkNow" onAction="#onCheckUpdate"
                        minWidth="-Infinity"/>
                <ProgressIndicator fx:id="updateProgress" visible="false" managed="false" prefWidth="16" prefHeight="16"/>
                <Label fx:id="updateStatusLabel" styleClass="muted" wrapText="true"/>
            </HBox>
        </VBox>

        <VBox styleClass="card" spacing="10">
            <Label text="%menu.help.about" styleClass="card-title"/>
            <Label fx:id="aboutLabel" wrapText="true"/>
            <HBox spacing="8">
                <Button text="%menu.help.github" onAction="#onOpenRepository"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
