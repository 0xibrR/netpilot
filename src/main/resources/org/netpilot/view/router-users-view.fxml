<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Hotspot users tab: WinBox-style toolbar, filters, users grouped by batch.
     Texts: %key refers to org/netpilot/i18n/messages_*.properties -->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.netpilot.controller.RouterUsersController"
            styleClass="page">

    <top>
        <VBox>
            <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="4">
                <Button fx:id="enableButton" text="%users.enable" onAction="#onEnable" styleClass="tool-button"/>
                <Button fx:id="disableButton" text="%users.disable" onAction="#onDisable" styleClass="tool-button"/>
                <Button fx:id="disconnectButton" text="%users.disconnect" onAction="#onDisconnect" styleClass="tool-button"/>
                <Button fx:id="deleteButton" text="%users.delete" onAction="#onDelete" styleClass="tool-button, danger"/>
                <Button fx:id="deleteExpiredButton" text="%users.deleteExpired" onAction="#onDeleteExpired"
                        styleClass="tool-button, danger"/>
                <Button fx:id="printButton" text="%users.print" onAction="#onPrint" styleClass="tool-button"/>
                <Separator orientation="VERTICAL"/>
                <Button text="%users.selectAll" onAction="#onSelectAll" styleClass="tool-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ProgressIndicator fx:id="progressIndicator" visible="false" managed="false" prefWidth="16" prefHeight="16"/>
                <Button fx:id="refreshButton" text="%button.refresh" onAction="#onRefresh" styleClass="tool-button"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="%users.search" prefColumnCount="18"/>
                <ComboBox fx:id="batchBox" prefWidth="270"/>
                <ComboBox fx:id="profileBox" prefWidth="130"/>
                <ComboBox fx:id="statusBox" prefWidth="180"/>
                <Button text="%users.clearFilters" onAction="#onClearFilters" styleClass="flat"/>
                <padding>
                    <Insets top="8" right="10" bottom="8" left="10"/>
                </padding>
            </HBox>
        </VBox>
    </top>

    <center>
        <TreeTableView fx:id="usersTable" showRoot="false">
            <columnResizePolicy>
                <TreeTableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TreeTableColumn fx:id="nameColumn" text="%users.column.name" prefWidth="270"/>
                <TreeTableColumn fx:id="onlineColumn" text="%users.column.connection" prefWidth="115" minWidth="105"/>
                <TreeTableColumn fx:id="profileColumn" text="%column.profile" prefWidth="80"/>
                <TreeTableColumn fx:id="serverColumn" text="%column.server" prefWidth="90"/>
                <TreeTableColumn fx:id="usedColumn" text="%users.column.used" prefWidth="105"/>
                <TreeTableColumn fx:id="limitColumn" text="%users.column.limit" prefWidth="70"/>
                <TreeTableColumn fx:id="expiresColumn" text="%users.column.expires" prefWidth="140"/>
                <TreeTableColumn fx:id="uploadColumn" text="%users.column.upload" prefWidth="95"/>
                <TreeTableColumn fx:id="downloadColumn" text="%users.column.download" prefWidth="95"/>
                <TreeTableColumn fx:id="stateColumn" text="%users.column.state" prefWidth="100"/>
                <TreeTableColumn fx:id="commentColumn" text="%users.column.comment" prefWidth="240"/>
            </columns>
            <placeholder>
                <Label fx:id="placeholderLabel" text="%users.loading" styleClass="muted"/>
            </placeholder>
        </TreeTableView>
    </center>

    <bottom>
        <HBox styleClass="table-footer" alignment="CENTER_LEFT" spacing="8">
            <Label fx:id="summaryLabel" styleClass="muted"/>
            <padding>
                <Insets top="5" right="10" bottom="5" left="10"/>
            </padding>
        </HBox>
    </bottom>
</BorderPane>
