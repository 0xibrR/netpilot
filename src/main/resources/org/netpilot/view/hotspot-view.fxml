<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Hotspot page: WinBox-style tabs. Texts: %key refers to org/netpilot/i18n/messages_*.properties -->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.netpilot.controller.HotspotController"
            styleClass="page">
    <top>
        <HBox alignment="CENTER_LEFT">
            <Label text="%nav.cards.users" styleClass="page-title"/>
            <padding>
                <Insets top="16" right="20" bottom="6" left="20"/>
            </padding>
        </HBox>
    </top>
    <center>
<TabPane fx:id="tabs" styleClass="winbox-tabs" tabClosingPolicy="UNAVAILABLE">

    <Tab fx:id="usersTab" text="%hotspot.tab.users">
        <fx:include fx:id="users" source="router-users-view.fxml"/>
    </Tab>

    <Tab fx:id="activeTab" text="%hotspot.tab.active">
        <BorderPane>
            <top>
                <VBox>
                    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="6">
                        <Button fx:id="refreshActiveButton" text="%button.refresh" onAction="#onRefreshActive" styleClass="tool-button"/>
                        <Button fx:id="kickButton" text="%users.disconnect" onAction="#onDisconnectSessions" styleClass="tool-button, danger"/>
                        <Separator orientation="VERTICAL"/>
                        <TextField fx:id="activeSearch" promptText="%hotspot.live.search" prefColumnCount="18"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ProgressIndicator fx:id="activeProgress" visible="false" managed="false" prefWidth="16" prefHeight="16"/>
                        <Label text="%hotspot.live.refreshEvery" styleClass="muted"/>
                        <ComboBox fx:id="intervalBox" prefWidth="120"/>
                    </HBox>
                    <Label fx:id="activeProblem" styleClass="status-error" wrapText="true" visible="false" managed="false">
                        <padding>
                            <Insets top="6" right="10" bottom="0" left="10"/>
                        </padding>
                    </Label>
                    <!-- one compact row of figures, so the table keeps most of the height -->
                    <HBox spacing="10">
                        <VBox styleClass="stat-card, compact" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label text="%dashboard.online" styleClass="stat-title"/>
                            <Label fx:id="onlineValue" text="—" styleClass="stat-value, stat-online"/>
                        </VBox>
                        <VBox styleClass="stat-card, compact" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label text="%hotspot.live.download" styleClass="stat-title"/>
                            <Label fx:id="downloadValue" text="—" styleClass="stat-value, live-download"/>
                        </VBox>
                        <VBox styleClass="stat-card, compact" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label text="%hotspot.live.upload" styleClass="stat-title"/>
                            <Label fx:id="uploadValue" text="—" styleClass="stat-value, live-upload"/>
                        </VBox>
                        <VBox styleClass="stat-card, compact" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label text="%hotspot.live.cpu" styleClass="stat-title"/>
                            <Label fx:id="cpuValue" text="—" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="stat-card, compact" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label text="%hotspot.live.memory" styleClass="stat-title"/>
                            <Label fx:id="memoryValue" text="—" styleClass="stat-value"/>
                        </VBox>
                        <padding>
                            <Insets top="10" right="10" bottom="6" left="10"/>
                        </padding>
                    </HBox>
                    <!-- the chart is a section with its own header: clicking the header folds it to one line -->
                    <VBox styleClass="fold-section">
                        <HBox fx:id="chartHeader" styleClass="fold-header" alignment="CENTER_LEFT" spacing="8"
                              focusTraversable="true">
                            <StackPane fx:id="chartIcon"/>
                            <Label text="%hotspot.live.chartTitle" styleClass="fold-title"/>
                            <Label fx:id="foldedDownload" styleClass="live-download, fold-figure"/>
                            <Label fx:id="foldedUpload" styleClass="live-upload, fold-figure"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <StackPane fx:id="chevron"/>
                        </HBox>
                        <!-- time runs left to right in every language, like WinBox and most charts -->
                        <LineChart fx:id="trafficChart" styleClass="live-chart" nodeOrientation="LEFT_TO_RIGHT"
                                   createSymbols="false" animated="false" legendSide="RIGHT"
                                   prefHeight="150" minHeight="150" maxHeight="150">
                            <xAxis>
                                <NumberAxis fx:id="timeAxis" autoRanging="false" lowerBound="-300" upperBound="0" tickUnit="60"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="%hotspot.live.unit" forceZeroInRange="true"/>
                            </yAxis>
                        </LineChart>
                        <VBox.margin>
                            <Insets top="0" right="10" bottom="8" left="10"/>
                        </VBox.margin>
                    </VBox>
                </VBox>
            </top>
            <center>
                <TableView fx:id="activeTable">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="activeUserColumn" text="%column.username" prefWidth="140"/>
                        <TableColumn fx:id="activeProfileColumn" text="%column.profile" prefWidth="90"/>
                        <TableColumn fx:id="activeAddressColumn" text="%hotspot.column.address" prefWidth="115"/>
                        <TableColumn fx:id="activeMacColumn" text="%hotspot.column.mac" prefWidth="135"/>
                        <TableColumn fx:id="activeUptimeColumn" text="%hotspot.column.sessionTime" prefWidth="95"/>
                        <TableColumn fx:id="activeLeftColumn" text="%hotspot.column.timeLeft" prefWidth="95"/>
                        <TableColumn fx:id="activeDownRateColumn" text="%hotspot.column.downRate" prefWidth="100"/>
                        <TableColumn fx:id="activeUpRateColumn" text="%hotspot.column.upRate" prefWidth="100"/>
                        <TableColumn fx:id="activeDownloadedColumn" text="%hotspot.column.downloaded" prefWidth="95"/>
                        <TableColumn fx:id="activeUploadedColumn" text="%hotspot.column.uploaded" prefWidth="95"/>
                    </columns>
                    <placeholder>
                        <Label text="%hotspot.noActive" styleClass="muted"/>
                    </placeholder>
                </TableView>
            </center>
        </BorderPane>
    </Tab>

    <Tab text="%hotspot.tab.profiles">
        <BorderPane>
            <top>
                <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="4">
                    <Button fx:id="newProfileButton" text="%profile.new" onAction="#onNewProfile" styleClass="tool-button"/>
                    <Button fx:id="editProfileButton" text="%profile.edit" onAction="#onEditProfile" styleClass="tool-button"/>
                    <Button fx:id="deleteProfileButton" text="%users.delete" onAction="#onDeleteProfile" styleClass="tool-button, danger"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="%profile.toolbarHint" styleClass="muted"/>
                </HBox>
            </top>
            <center>
                <TableView fx:id="profilesTable">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="profileNameColumn" text="%column.profile" prefWidth="160"/>
                        <TableColumn fx:id="profileDownloadColumn" text="%profile.download" prefWidth="120"/>
                        <TableColumn fx:id="profileUploadColumn" text="%profile.upload" prefWidth="120"/>
                        <TableColumn fx:id="profileSharedColumn" text="%profile.sharedUsers" prefWidth="110"/>
                        <TableColumn fx:id="profileValidityColumn" text="%profile.validity" prefWidth="110"/>
                        <TableColumn fx:id="profilePriceColumn" text="%report.column.price" prefWidth="120"/>
                    </columns>
                    <placeholder>
                        <Label text="%reports.noProfiles" styleClass="muted"/>
                    </placeholder>
                </TableView>
            </center>
        </BorderPane>
    </Tab>

    <Tab text="%hotspot.tab.servers">
        <TableView fx:id="serversTable">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="serverNameColumn" text="%column.server" prefWidth="180"/>
                <TableColumn fx:id="serverInterfaceColumn" text="%hotspot.column.interface" prefWidth="180"/>
                <TableColumn fx:id="serverStateColumn" text="%users.column.state" prefWidth="120"/>
            </columns>
            <placeholder>
                <Label text="%hotspot.noServers" styleClass="muted"/>
            </placeholder>
        </TableView>
    </Tab>
</TabPane>
    </center>
</BorderPane>
