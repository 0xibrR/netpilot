<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.netpilot.controller.PreferencesController"
      styleClass="app-root" spacing="14" prefWidth="420">
    <padding>
        <Insets top="18" right="18" bottom="14" left="18"/>
    </padding>

    <GridPane hgap="12" vgap="10" styleClass="card">
        <columnConstraints>
            <ColumnConstraints minWidth="90"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="%prefs.language" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="languageBox" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label fx:id="restartNote" text="%prefs.restartNote" styleClass="warning" wrapText="true"
               GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
        <Label text="%prefs.theme" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="themeBox" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button text="%button.cancel" onAction="#onCancel" cancelButton="true"/>
        <Button text="%button.save" onAction="#onSave" defaultButton="true" styleClass="primary"/>
    </HBox>
</VBox>
