<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Cashier shifts (owner): every shift with its expected and counted cash.
     Texts: %key refers to org/netpilot/i18n/messages_*.properties -->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.netpilot.controller.ShiftsController"
            styleClass="page">

    <top>
        <HBox alignment="CENTER_LEFT">
            <Label text="%nav.SHIFTS" styleClass="page-title"/>
            <padding>
                <Insets top="16" right="20" bottom="6" left="20"/>
            </padding>
        </HBox>
    </top>

    <center>
        <TableView fx:id="shiftsTable">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="openedColumn" text="%shift.column.opened" prefWidth="135"/>
                <TableColumn fx:id="closedColumn" text="%shift.column.closed" prefWidth="135"/>
                <TableColumn fx:id="byColumn" text="%shift.column.by" prefWidth="80"/>
                <TableColumn fx:id="openingColumn" text="%shift.openingCash" prefWidth="95"/>
                <TableColumn fx:id="salesColumn" text="%shift.column.sales" prefWidth="95"/>
                <TableColumn fx:id="paymentsColumn" text="%shift.column.payments" prefWidth="95"/>
                <TableColumn fx:id="withdrawnColumn" text="%shift.column.withdrawn" prefWidth="95"/>
                <TableColumn fx:id="expectedColumn" text="%shift.column.expected" prefWidth="95"/>
                <TableColumn fx:id="countedColumn" text="%shift.counted" prefWidth="95"/>
                <TableColumn fx:id="differenceColumn" text="%shift.column.difference" prefWidth="95"/>
                <TableColumn fx:id="noteColumn" text="%shift.note" prefWidth="140"/>
            </columns>
            <placeholder>
                <Label text="%shift.empty" styleClass="muted"/>
            </placeholder>
            <BorderPane.margin>
                <Insets top="12" right="12" left="12"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <FlowPane styleClass="action-bar" alignment="CENTER_LEFT" hgap="10" vgap="8">
            <Label fx:id="summaryLabel" styleClass="muted"/>
            <Button fx:id="refreshButton" text="%button.refresh" onAction="#onRefresh" minWidth="-Infinity"/>
            <Button fx:id="detailsButton" text="%shift.details" onAction="#onDetails" minWidth="-Infinity"/>
            <Button fx:id="receiptButton" text="%shift.receipt" onAction="#onReceipt" minWidth="-Infinity"/>
            <Button fx:id="closeButton" text="%shift.close" onAction="#onClose" minWidth="-Infinity"/>
            <Button fx:id="exportButton" text="%users.exportExcel" onAction="#onExport" minWidth="-Infinity"/>
            <padding>
                <Insets top="10" right="12" bottom="10" left="12"/>
            </padding>
        </FlowPane>
    </bottom>
</BorderPane>
