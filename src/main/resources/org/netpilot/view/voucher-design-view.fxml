<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.netpilot.controller.VoucherDesignController"
            styleClass="app-root" prefWidth="900" prefHeight="620">

    <!-- ===== Left: settings ===== -->
    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll" prefWidth="430">
            <VBox spacing="12" styleClass="form">
                <VBox styleClass="card" spacing="10">
                    <Label text="%design.text" styleClass="card-title"/>
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="110"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="%design.networkName" GridPane.rowIndex="0"/>
                        <TextField fx:id="networkNameField" promptText="%design.networkName.prompt" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="%design.note" GridPane.rowIndex="1"/>
                        <TextField fx:id="noteField" promptText="%design.note.prompt" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="%design.labels" GridPane.rowIndex="2"/>
                        <ComboBox fx:id="languageBox" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="%design.color" GridPane.rowIndex="3"/>
                        <ColorPicker fx:id="colorPicker" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="%design.logo" GridPane.rowIndex="4"/>
                        <HBox spacing="6" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="1">
                            <Label fx:id="logoLabel" styleClass="muted" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="%design.chooseLogo" onAction="#onChooseLogo"/>
                            <Button fx:id="removeLogoButton" text="%design.removeLogo" onAction="#onRemoveLogo"/>
                        </HBox>
                    </GridPane>
                </VBox>

                <VBox styleClass="card" spacing="8">
                    <Label text="%design.show" styleClass="card-title"/>
                    <HBox spacing="14">
                        <CheckBox fx:id="showQrCheck" text="%design.show.qr"/>
                        <CheckBox fx:id="showUptimeCheck" text="%design.show.time"/>
                        <CheckBox fx:id="showPriceCheck" text="%design.show.price"/>
                        <CheckBox fx:id="showProfileCheck" text="%design.show.profile"/>
                    </HBox>
                </VBox>

                <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
                    <Label text="%design.prices" styleClass="card-title"/>
                    <Label text="%design.prices.help" styleClass="muted" wrapText="true"/>
                    <TableView fx:id="pricesTable" editable="true" prefHeight="200">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="profileColumn" text="%column.profile" prefWidth="140" editable="false"/>
                            <TableColumn fx:id="priceColumn" text="%report.column.price" prefWidth="180"/>
                        </columns>
                        <placeholder>
                            <Label text="%design.prices.empty" styleClass="muted"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </left>

    <!-- ===== Center: live preview (a paper voucher, so it stays white in dark mode) ===== -->
    <center>
        <VBox spacing="10" alignment="TOP_CENTER" styleClass="preview">
            <Label text="%main.preview" styleClass="section-title"/>
            <VBox fx:id="voucherCard" styleClass="voucher-card" alignment="TOP_CENTER" spacing="3" maxWidth="230">
                <ImageView fx:id="logoView" fitHeight="36" fitWidth="150" preserveRatio="true"/>
                <Label fx:id="titleLabel" styleClass="voucher-title" wrapText="true"/>
                <Label fx:id="profileLabel" styleClass="voucher-small"/>
                <HBox fx:id="userRow" alignment="CENTER" spacing="4">
                    <Label fx:id="userLabel" styleClass="voucher-label"/>
                    <Label text="714133" styleClass="voucher-value"/>
                </HBox>
                <HBox fx:id="passRow" alignment="CENTER" spacing="4">
                    <Label fx:id="passLabel" styleClass="voucher-label"/>
                    <Label text="5821" styleClass="voucher-value"/>
                </HBox>
                <HBox fx:id="timeRow" alignment="CENTER" spacing="4">
                    <Label fx:id="timeLabel" styleClass="voucher-label"/>
                    <Label fx:id="timeValue" styleClass="voucher-value"/>
                </HBox>
                <HBox fx:id="priceRow" alignment="CENTER" spacing="4">
                    <Label fx:id="priceLabel" styleClass="voucher-label"/>
                    <Label fx:id="priceValue" styleClass="voucher-value"/>
                </HBox>
                <Label fx:id="qrBox" text="QR" styleClass="voucher-qr" minWidth="70" minHeight="70" alignment="CENTER"/>
                <Label fx:id="noteLabel" styleClass="voucher-small" wrapText="true"/>
                <padding>
                    <Insets top="10" right="12" bottom="12" left="12"/>
                </padding>
            </VBox>
            <Label text="%design.preview.help" styleClass="muted" wrapText="true" maxWidth="260"/>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="action-bar" alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="testPrintButton" text="%design.testPrint" onAction="#onTestPrint"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%button.cancel" onAction="#onCancel" cancelButton="true"/>
            <Button text="%button.save" onAction="#onSave" defaultButton="true" styleClass="primary"/>
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
        </HBox>
    </bottom>
</BorderPane>
