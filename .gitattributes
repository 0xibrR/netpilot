# Normalize line endings in the repository; check out with the OS default.
* text=auto

# Shell scripts must keep LF or they fail on Linux/macOS (including CI).
mvnw text eol=lf
*.sh text eol=lf

# Windows scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.ico binary
*.pdf binary
